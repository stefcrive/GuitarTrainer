# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-documents-check/
/.next-practice-check/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated document OCR runtimes and local book annotations
/public/document-assets/
/.document-tools/
**/.guitar-documents/

# local practice media
/GT Listening Folder/*
!/GT Listening Folder/.gitkeep
!/GT Listening Folder/*.json
!/GT Listening Folder/*.sqlite
